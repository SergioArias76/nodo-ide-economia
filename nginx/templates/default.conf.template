# Procesado por la imagen oficial de nginx (envsubst) al iniciar.

# Imágenes del mapa y leyendas de GeoServer: el navegador las reutiliza 5 minutos (volver a una zona o
# prender y apagar una capa no repite el pedido, que por el túnel de Cloudflare suma ~1 s). Los filtros
# del visor van en la URL (CQL_FILTER), así que un filtro nuevo es otro pedido
map $args $cache_geoserver {
    "~*(^|&)request=(GetMap|GetLegendGraphic)(&|$)" "public, max-age=300";
    default "";
}

server {
    listen 80;
    server_name ${DOMINIO};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMINIO};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 100m;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Administración de GeoServer solo desde la máquina: lo que llega por Cloudflare Tunnel trae CF-Connecting-IP
    location ~ ^/geoserver/(web|rest)(/|$) {
        if ($http_cf_connecting_ip) { return 403; }
        proxy_pass http://geoserver:8080;
    }

    # Pantalla interna de ubicación manual de proveedores y su API: tampoco por el túnel (además pide contraseña)
    location ~ ^/(api/)?ubicaciones(/|$) {
        if ($http_cf_connecting_ip) { return 403; }
        proxy_pass http://portal:3000;
    }

    location /geoserver/ {
        proxy_pass http://geoserver:8080/geoserver/;
        proxy_read_timeout 300s;
        add_header Cache-Control $cache_geoserver;
    }

    location /geonetwork/ {
        proxy_pass http://geonetwork:8080/geonetwork/;
        proxy_read_timeout 300s;
    }

    location / {
        proxy_pass http://portal:3000;
    }
}
