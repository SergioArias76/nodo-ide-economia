# Copiar a .env y completar. Nunca versionar .env.

# Dominio público (en dev: localhost)
DOMINIO=localhost

# Versiones de imágenes
POSTGIS_VERSION=16-3.5
GEOSERVER_VERSION=2.27.2
GEONETWORK_VERSION=4.4.8
ELASTICSEARCH_VERSION=8.14.3
NGINX_VERSION=1.27-alpine

# PostgreSQL / PostGIS
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar
# postgis/initdb/20-proveedores.sql asume IDE_DB=ide
IDE_DB=ide
IDE_ADMIN_PASSWORD=cambiar
GEOSERVER_DB_PASSWORD=cambiar
GEONETWORK_DB=geonetwork
GEONETWORK_DB_USER=geonetwork
GEONETWORK_DB_PASSWORD=cambiar

# GeoServer
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=cambiar
GEOSERVER_JAVA_OPTS=-Xms512m -Xmx2g

# GeoNetwork
# Conserva las opciones por defecto de la imagen oficial; solo se ajusta la memoria
GEONETWORK_JAVA_OPTS=-Dorg.eclipse.jetty.annotations.AnnotationParser.LEVEL=OFF -Djava.security.egd=file:/dev/./urandom -Djava.awt.headless=true -Xms512m -Xmx1g
ES_JAVA_OPTS=-Xms512m -Xmx512m
